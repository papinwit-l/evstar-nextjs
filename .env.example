# WordPress (evstar-core). Leave WORDPRESS_GRAPHQL_URL empty to run on the mock data.
WORDPRESS_GRAPHQL_URL=https://cms.example.com/graphql

# Shared with EVSTAR_REVALIDATE_SECRET in the CMS's wp-config.php
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Safety-net revalidation in seconds. Edits refresh immediately via /api/revalidate,
# so this can stay long to limit ISR writes on Vercel. Default 3600.
WP_REVALIDATE_SECONDS=3600
